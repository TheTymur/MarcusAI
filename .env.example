# Google Gemini AI (Required)
# Get your API key at: https://aistudio.google.com/
API_KEY_GEMINI=your_gemini_api_key_here

# Telegram User Client (Optional - for Telegram MCP Server) 
# Obtain API ID and Hash at: https://my.telegram.org
API_TELEGRAM_ID=your_telegram_api_id
API_TELEGRAM_HASH=your_telegram_api_hash
TELEGRAM_SESSION_NAME=marcus_session

# Telegram Bot UI (Optional - for running marcus_bot.py) 
# Create a bot via @BotFather on Telegram to get your bot token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Security: Set your personal Telegram numeric user ID to restrict access.
# Strangers messaging the bot will be blocked automatically.
# You can find your ID via bots like @userinfobot.
ALLOWED_TELEGRAM_USER_ID=123456789

# Local Ollama / ChromaDB (Optional - for offline embeddings & fallback) 
# Default Ollama instance URL (runs locally on port 11434):
# OLLAMA_HOST=http://localhost:11434

